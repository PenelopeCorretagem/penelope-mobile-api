# Segredo local para assinatura dos tokens JWT. Gere um valor aleatório antes de usar.
JWT_API_KEY=SUBSTITUA_POR_UM_SEGREDO_LOCAL_ALEATORIO

# Endereços permitidos para CORS e links de redefinição de senha.
CORS_ALLOWED_ORIGINS=http://localhost:8081
APP_FRONTEND_URL=http://localhost:8081

# SMTP usado para envio de recuperação de senha (ajuste ao provedor local).
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=25
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# Gemini usado somente pelo endpoint backend de interpretação.
GEMINI_API_KEY=SUBSTITUA_PELA_CHAVE_GEMINI
GEMINI_MODEL=gemini-3.6-flash

# Porta HTTP da API Spring Boot unificada.
SERVER_PORT=8080
